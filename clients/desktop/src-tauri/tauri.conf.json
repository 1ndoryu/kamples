{
  "$schema": "https://raw.githubusercontent.com/nicdelhi/tauri2-schema/main/tauri.conf.json",
  "productName": "Kamples",
  "version": "0.1.0",
  "identifier": "app.kamples.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:4317; connect-src 'self' http://127.0.0.1:4317 ws://127.0.0.1:4317 https://api.kamples.com wss://api.kamples.com https://*.stripe.com https://accounts.google.com ipc: http://ipc.localhost; img-src 'self' http://127.0.0.1:4317 asset: http://asset.localhost data: blob: https:; media-src 'self' http://127.0.0.1:4317 asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' https://accounts.google.com; frame-src 'self' https://accounts.google.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/32x32.png",
      "icons/favicon.svg"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "kamples"
          ],
          "host": "auth"
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMkY4N0I4MjEzRkZCOTcKUldTWCt6OGh1SWN2VTJoblVNQm9vUnVzU0NaVTczQjMvQW1TcTBHNDNOQWVMWDN2ZmZDeUF5RjcK",
      "endpoints": [
        "https://api.kamples.com/api/app/updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}